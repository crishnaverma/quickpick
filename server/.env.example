PORT=5000
NODE_ENV=development
# Database connection: PostgreSQL (set to your PostgreSQL database URL, e.g. Neon, Supabase, Render, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickpick?schema=public"

# SQLite local fallback (if local PostgreSQL is not running during local dev):
# SQLITE_DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="quickpick-super-secure-production-jwt-secret-2026"
JWT_EXPIRES_IN="7d"

# Razorpay Configuration (Test Mode)
# Replace with your Razorpay dashboard test keys when testing live checkout
RAZORPAY_KEY_ID="rzp_test_quickpick2026"
RAZORPAY_KEY_SECRET="quickpick_test_secret_key_placeholder"
RAZORPAY_WEBHOOK_SECRET="quickpick_test_webhook_secret_key"

# Client CORS URL
CLIENT_URL="http://localhost:5173"
