datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UnitType {
  FIXED
  WEIGHT
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COLLECTED
  CANCELLED
  REJECTED
}

enum PickupType {
  ASAP
  SCHEDULED
}

enum PaymentMethod {
  RAZORPAY
  CASH_ON_PICKUP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PickupStatus {
  PENDING
  READY
  COLLECTED
  EXPIRED
}

enum InventoryMovementType {
  STOCK_IN
  RESERVATION
  SALE
  RELEASE
  ADJUSTMENT
  LOSS
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CUSTOMER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses    Address[]
  cart         Cart?
  orders       Order[]
  auditLogs    AuditLog[]
  movements    InventoryMovement[] @relation("StaffInventoryMovements")
  collectedPickups Pickup[]        @relation("StaffCollectedPickups")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("Home") // Home, Work, Other
  street     String
  city       String
  postalCode String
  landmark   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id                String              @id @default(uuid())
  categoryId        String
  name              String
  slug              String              @unique
  description       String?
  images            String[]            @default([])
  unitType          UnitType            @default(FIXED)
  defaultUnit       String              // e.g. "1 pc", "500g", "1 kg", "1 pack"
  price             Decimal             @db.Decimal(10, 2)
  compareAtPrice    Decimal?            @db.Decimal(10, 2)
  costPrice         Decimal?            @db.Decimal(10, 2)
  stockQuantity     Int                 @default(0)
  reservedStock     Int                 @default(0)
  minStockThreshold Int                 @default(5)
  isAvailable       Boolean             @default(true)
  isActive          Boolean             @default(true)
  variants          Json?               // Predefined weight variants [{ label: "250g", multiplier: 0.25 }, ...]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isAvailable])
  @@index([stockQuantity])
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    @unique
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  productId     String
  unitVariant   String   @default("default") // e.g., "default", "250g", "500g", "1kg"
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, unitVariant])
  @@index([cartId])
  @@index([productId])
}

model PickupSlot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  startTime   String   // "09:00"
  endTime     String   // "09:30"
  maxOrders   Int      @default(10)
  bookedCount Int      @default(0)
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@unique([date, startTime, endTime])
  @@index([date, isClosed])
}

model Order {
  id                  String       @id @default(uuid())
  orderNumber         String       @unique // QP-20261121-0001
  userId              String
  pickupSlotId        String?
  status              OrderStatus  @default(PLACED)
  pickupType          PickupType   @default(ASAP)
  estimatedPickupTime DateTime?
  idempotencyKey      String?      @unique
  subtotal            Decimal      @db.Decimal(10, 2)
  taxTotal            Decimal      @default(0.00) @db.Decimal(10, 2)
  discountTotal       Decimal      @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal      @db.Decimal(10, 2)
  notes               String?
  rejectionReason     String?
  cancellationReason  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  pickupSlot          PickupSlot?  @relation(fields: [pickupSlotId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?
  pickup              Pickup?
  movements           InventoryMovement[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([pickupSlotId])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productUnit String
  unitVariant String   @default("default")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  method            PaymentMethod @default(CASH_ON_PICKUP)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  failureReason     String?
  refundId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([razorpayOrderId])
}

model Pickup {
  id                 String       @id @default(uuid())
  orderId            String       @unique
  pickupToken        String       @unique // Secure cryptographic random string
  qrCodeDataUrl      String       // Stored QR code data URL (contains token/validation hash, no personal info)
  status             PickupStatus @default(PENDING)
  scheduledSlot      String?      // e.g. "10:00 AM - 10:30 AM" or "ASAP (Est. 15-20 min)"
  estimatedTime      DateTime?
  readyAt            DateTime?
  collectedAt        DateTime?
  collectedByStaffId String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedByStaff   User?        @relation("StaffCollectedPickups", fields: [collectedByStaffId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([pickupToken])
  @@index([status])
}

model InventoryMovement {
  id               String                @id @default(uuid())
  productId        String
  orderId          String?
  type             InventoryMovementType
  quantity         Int                   // Positive for addition/return, negative for reservation/sale
  balanceAfter     Int
  notes            String?
  createdByStaffId String?
  createdAt        DateTime              @default(now())

  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  staff            User?                 @relation("StaffInventoryMovements", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model ShopSettings {
  id                  String   @id @default("shop-settings-primary")
  shopName            String   @default("QuickPick Fresh Market")
  tagline             String   @default("Your Neighborhood Fresh Grocery & Quick Pickup")
  phone               String   @default("+91 98765 43210")
  email               String   @default("support@quickpickgrocery.com")
  address             String   @default("Shop #4, Green Glen Plaza, 100 Feet Road, Bangalore, KA 560103")
  openingTime         String   @default("07:00")
  closingTime         String   @default("22:00")
  slotDurationMinutes Int      @default(30)
  maxOrdersPerSlot    Int      @default(12)
  isShopOpen          Boolean  @default(true)
  acceptAsap          Boolean  @default(true)
  taxRate             Decimal  @default(0.05) @db.Decimal(5, 4) // 5% GST
  currency            String   @default("INR")
  minOrderAmount      Decimal  @default(99.00) @db.Decimal(10, 2)
  razorpayKeyId       String?  @default("rzp_test_placeholder")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaymentWebhookEvent {
  id          String        @id @default(uuid())
  eventId     String        @unique
  eventType   String
  payload     Json
  status      WebhookStatus @default(PENDING)
  processedAt DateTime?
  error       String?
  createdAt   DateTime      @default(now())

  @@index([eventId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
